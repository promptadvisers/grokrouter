#!/usr/bin/env bash
set -u

SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_SOURCE" ]]; do
  SCRIPT_DIRECTORY="$(cd -P "$(dirname "$SCRIPT_SOURCE")" && pwd)"
  SCRIPT_SOURCE="$(readlink "$SCRIPT_SOURCE")"
  if [[ "$SCRIPT_SOURCE" != /* ]]; then
    SCRIPT_SOURCE="$SCRIPT_DIRECTORY/$SCRIPT_SOURCE"
  fi
done
INSTALL_ROOT="$(cd -P "$(dirname "$SCRIPT_SOURCE")/.." && pwd)"
CONFIG_PATH="$INSTALL_ROOT/provider.json"
PATCHER="$INSTALL_ROOT/patch/router_patch.py"
HOST_REGISTRY_TOOL="$INSTALL_ROOT/bin/host-registry"
GROK_VERSION="$("$HOST_REGISTRY_TOOL" version)" || exit 1
MANIFEST="$INSTALL_ROOT/patch/manifests/$GROK_VERSION.json"
HOST="${ROUTER_PATCH_HOST:-/home/box/sand-host/host-main.cjs}"
BACKUP="${ROUTER_PATCH_BACKUP:-/home/box/sand-data/grokbot-router-backup/host-main.cjs.stock}"
LOCK_DIR="/home/box/sand-data/grokbot-router-watchdog.lock"
LOG_PATH="/home/box/sand-data/grokbot-router-watchdog-events.log"

ACTIVE_REGISTRY=""
set_registry_args() {
  ACTIVE_REGISTRY=""
  if [[ -x "$HOST_REGISTRY_TOOL" ]] && registry_path="$("$HOST_REGISTRY_TOOL" verify 2>/dev/null)"; then
    ACTIVE_REGISTRY="$registry_path"
  fi
}
set_registry_args
run_patch_doctor() {
  if [[ -n "$ACTIVE_REGISTRY" ]]; then
    python3 "$PATCHER" --doctor --host "$HOST" --backup "$BACKUP" --manifest "$MANIFEST" --host-registry "$ACTIVE_REGISTRY" --json
  else
    python3 "$PATCHER" --doctor --host "$HOST" --backup "$BACKUP" --manifest "$MANIFEST" --json
  fi
}
run_patch_install() {
  if [[ -n "$ACTIVE_REGISTRY" ]]; then
    python3 "$PATCHER" --host "$HOST" --backup "$BACKUP" --manifest "$MANIFEST" --host-registry "$ACTIVE_REGISTRY" --json
  else
    python3 "$PATCHER" --host "$HOST" --backup "$BACKUP" --manifest "$MANIFEST" --json
  fi
}

if ! mkdir "$LOCK_DIR" 2>/dev/null; then
  exit 0
fi
trap 'rmdir "$LOCK_DIR" 2>/dev/null || true' EXIT
trap 'rmdir "$LOCK_DIR" 2>/dev/null || true; exit 0' INT TERM

log_event() {
  printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" >> "$LOG_PATH"
}

auto_repair_enabled() {
  python3 - "$CONFIG_PATH" <<'PY' >/dev/null 2>&1
import json
import sys

try:
    config = json.load(open(sys.argv[1]))
except Exception:
    raise SystemExit(1)
raise SystemExit(0 if config.get("enabled") is True and config.get("autoRepair") is True else 1)
PY
}

repair_count=0
repair_window_start="$(date +%s)"
last_registry_refresh=0
while true; do
  sleep 5
  auto_repair_enabled || continue
  if run_patch_doctor >/dev/null 2>&1; then
    repair_count=0
    repair_window_start="$(date +%s)"
    continue
  fi

  now="$(date +%s)"
  if (( now - last_registry_refresh > 3600 )) && [[ -x "$HOST_REGISTRY_TOOL" ]]; then
    if "$HOST_REGISTRY_TOOL" refresh >/dev/null 2>&1; then
      set_registry_args
      log_event "signed-compatibility-registry-refreshed"
    fi
    last_registry_refresh="$now"
  fi
  if (( now - repair_window_start > 300 )); then
    repair_count=0
    repair_window_start="$now"
  fi
  if (( repair_count >= 3 )); then
    log_event "repair-paused-rate-limit"
    sleep 300
    repair_count=0
    repair_window_start="$(date +%s)"
    continue
  fi

  if run_patch_install >/dev/null 2>&1; then
    repair_count=$((repair_count + 1))
    log_event "known-stock-host-repaired"
    pkill -f '/home/box/sand-host/host-main.cjs' >/dev/null 2>&1 || true
    sleep 15
  else
    # Hosts that fail both the exact signed list and structural verification
    # (marker-free, every anchor exactly once, read-only patch passes) remain
    # untouched. Retry slowly in case Grok is still staging a stock host.
    log_event "repair-refused-unknown-or-incomplete-host"
    sleep 60
  fi
done
